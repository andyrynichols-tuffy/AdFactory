        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Novo projeto"
          }
        }
      }
    },
    "Next line": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Próxima fala"
          }
        }
      }
    },
    "Next project": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Próximo projeto"
          }
        }
      }
    },
    "No clips yet. Tap Film to start.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum clipe ainda. Toque em Filmar para começar."
          }
        }
      }
    },
    "No script": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem roteiro"
          }
        }
      }
    },
