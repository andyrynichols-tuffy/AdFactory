      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não está chegando som. O transmissor do microfone está ligado?"
          }
        }
      }
    },
    "No sound in this take": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Take sem som"
          }
        }
      }
    },
    "No videos yet: Ad Factory makes them once the takes are cut.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há vídeos: o Ad Factory faz quando os takes forem cortados."
          }
        }
      }
    },
    "None": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum"
          }
        }
      }
    },
    "Not Shop-safe": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é seguro para o Shop"
          }
        }
      }
    },
    "Not in this video": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não está neste vídeo"
          }
        }
      }
    },
    "Not posted": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não postado"
          }
        }
      }
    },
    "Nothing waiting to be filmed. Tap ＋ to start a project.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada esperando para filmar. Toque em ＋ para começar um projeto."
          }
        }
      }
    },
    "Now in this video; the take that was here went to the rejects.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora está neste vídeo; o take que estava aqui foi para os descartados."
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligado"
          }
        }
      }
    },
    "One line per line of the script…": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma linha por linha do roteiro…"
          }
        }
      }
    },
    "Open a project on the phone and tap Film: the camera and the script show up here.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra um projeto no celular e toque em Filmar: a câmera e o roteiro aparecem aqui."
          }
        }
      }
    },
    "Other": {
      "localizations": {
        "pt-BR": {
