{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@ s at %@×": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ s a %2$@×"
          }
        }
      }
    },
    "%lld filmed here": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld filmados aqui"
          }
        }
      }
    },
    "%lld lines": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld linhas"
          }
        }
      }
    },
    "%lld takes": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld takes"
          }
        }
      }
    },
    "%lld takes waiting to upload": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld takes esperando para enviar"
          }
        }
      }
    },
    "%lld to send": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld para enviar"
          }
        }
      }
    },
    "%lld videos cut · %lld saved": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld vídeos cortados · %lld salvos"
          }
        }
      }
    },
    "%lld videos in Ad Factory": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld vídeos no Ad Factory"
          }
        }
      }
    },
    "AE/AF LOCK": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "AE/AF TRAVADO"
          }
        }
      }
    },
    "Ad Camera films your TikTok Shop videos.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Ad Camera filma seus vídeos do TikTok Shop."
          }
        }
      }
    },
    "Ad Camera needs the camera. Allow it in the iPhone's Settings.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Ad Camera precisa da câmera. Permita nos Ajustes do iPhone."
          }
        }
      }
    },
    "Ad Factory answered %lld.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Ad Factory respondeu %lld."
          }
        }
      }
    },
    "Ad Factory is pre-cutting the clips…": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Ad Factory está pré-cortando os clipes…"
          }
        }
      }
    },
    "Ad Factory password": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Senha do Ad Factory"
          }
        }
      }
    },
    "Address": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Endereço"
          }
        }
      }
    },
    "All sent": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo enviado"
          }
        }
      }
    },
    "All takes sent to OneDrive": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os takes enviados ao OneDrive"
          }
        }
      }
    },
    "Allow Ad Camera to add to Photos in Settings.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que o Ad Camera adicione às Fotos nos Ajustes."
          }
        }
      }
    },
    "Allow Photos for Ad Camera in the iPhone's Settings to save takes to the album.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita as Fotos para o Ad Camera nos Ajustes do iPhone para salvar os takes no álbum."
          }
        }
      }
    },
    "Auto · %@×": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Automática · %@×"
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltar"
          }
        }
      }
    },
    "Back to projects": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltar aos projetos"
          }
        }
      }
    },
    "Back to the TikTok defaults": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltar ao padrão do TikTok"
          }
        }
      }
    },
    "Back to what was said": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltar ao que foi dito"
          }
        }
      }
    },
    "Brightness": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Brilho"
          }
        }
      }
    },
    "Camera": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Câmera"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        }
      }
    },
    "Captions": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Legendas"
          }
        }
      }
    },
    "Captions edited": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Legendas editadas"
          }
        }
      }
    },
    "Check wording": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira as palavras"
          }
        }
      }
    },
    "Cinematic (smoother, crops more)": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinemática (mais suave, corta mais)"
          }
        }
      }
    },
    "Clamp": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Garra"
          }
        }
      }
    },
    "Clear sent": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpar enviados"
          }
        }
      }
    },
    "Couldn't open that camera.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não deu para abrir essa câmera."
          }
        }
      }
    },
    "Couldn't open the project": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não deu para abrir o projeto"
          }
        }
      }
    },
    "Countdown": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contagem regressiva"
          }
        }
      }
    },
    "Cut off": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cortado"
          }
        }
      }
    },
    "Decide later": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Decidir depois"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "Drag along the bar to find the spot, then set the start or end there. ± moves it a twentieth of a second.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste na barra para achar o ponto e marque o início ou o fim ali. ± move um vigésimo de segundo."
          }
        }
      }
    },
    "Drag the strip's edge to the clamp's edge. Double-tap the strip to move it to the other end. The picture shrinks to fit the rest of the screen.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste a borda da faixa até a borda da garra. Toque duas vezes na faixa para levá-la à outra ponta. A imagem diminui para caber no resto da tela."
          }
        }
      }
    },
    "Earlier": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes"
          }
        }
      }
    },
    "Edit line %lld": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Editar a linha %lld"
          }
        }
      }
    },
    "Edit videos": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Editar vídeos"
          }
        }
      }
    },
    "End": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fim"
          }
        }
      }
    },
    "Every take also saves to the \"Ad Studio\" album in Photos. Uploads go into the project's OneDrive folder and keep going with the phone locked.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada take também é salvo no álbum \"Ad Studio\" das Fotos. Os envios vão para a pasta do projeto no OneDrive e continuam com o celular bloqueado."
          }
        }
      }
    },
    "Film": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmar"
          }
        }
      }
    },
    "Film it": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmar"
          }
        }
      }
    },
    "Filmed on this phone": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmados neste celular"
          }
        }
      }
    },
    "Filmed: add more takes": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmados: adicione mais takes"
          }
        }
      }
    },
    "Filming": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmagem"
          }
        }
      }
    },
    "Fixing a word keeps its timing. Adding or removing words spreads them over the same stretch.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrigir uma palavra mantém o tempo dela. Pôr ou tirar palavras espalha todas pelo mesmo trecho."
          }
        }
      }
    },
    "Flub": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Erro"
          }
        }
      }
    },
    "Format": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato"
          }
        }
      }
    },
    "Frame rate": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxa de quadros"
          }
        }
      }
