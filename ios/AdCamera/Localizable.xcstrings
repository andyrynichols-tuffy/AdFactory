    "Layout": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Layout"
          }
        }
      }
    },
    "Left empty, it's named after the product and today's date.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ficar vazio, leva o nome do produto e a data de hoje."
          }
        }
      }
    },
    "Line %lld": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Linha %lld"
          }
        }
      }
    },
    "Line %lld of %lld": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Linha %lld de %lld"
          }
        }
      }
    },
    "Makes the finished video on the PC. Takes a minute or two.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz o vídeo final no PC. Leva um ou dois minutos."
          }
        }
      }
    },
    "Mark posted": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcar como postado"
          }
        }
      }
    },
    "Mic is off": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Microfone desligado"
          }
        }
